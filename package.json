{
  "name": "riichi-score-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js && npm run test:rules",
    "test:browser": "node tests/browser.mjs",
    "sync:mini": "node scripts/sync-mini-core.mjs",
    "build": "node scripts/build-online.mjs",
    "test:online": "node --test tests/online*.test.js",
    "test:online:browser": "node tests/online-browser.mjs",
    "test:rules": "vitest run --config vitest.config.js",
    "pretest": "npm run build",
    "check:mini:templates": "node scripts/check-mini-templates.mjs",
    "test:online:interactions": "node tests/online-interactions-browser.mjs",
    "sync:mini:assets": "node scripts/sync-mini-assets.mjs",
    "test:mini:layout": "node tests/online-mini-layout-browser.mjs"
  },
  "dependencies": {
    "@kobalab/majiang-core": "1.4.1",
    "lucide-react": "1.47.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "jsqr": "^1.4.0",
    "miniprogram-simulate": "1.6.2",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
