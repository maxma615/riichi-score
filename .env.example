PORT=3200
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3200
APP_BASE_PATH=
DATA_DIR=.local/data

# score | online | both（默认 both，本地测试不变；ECS 记分站用 score）
APP_MODE=both
# 记分站退役联机时的对外说明／日后跳转目标（无尾斜杠）
ONLINE_PUBLIC_ORIGIN=https://mahjong.yougui.online

# 小程序配置：AppSecret仅配置在服务器，不提交真实值。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENV_VERSION=release

# 日后独立联机容器示例（勿提交真实值）：
# APP_MODE=online
# APP_ORIGIN=https://mahjong.yougui.online
# APP_BASE_PATH=
