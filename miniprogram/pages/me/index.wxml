<view class="page"><view class="title">我的牌谱</view><view class="card"><view class="row" bindtap="profile"><image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}"/><text>{{profile.name || '设置头像与昵称'}}</text></view><view class="label">月份</view><picker mode="date" fields="month" value="{{month}}" bindchange="month">{{month}}</picker></view><view class="card" wx:if="{{stats}}"><view class="heading">本月收支</view><view class="score {{stats.net>=0?'positive':'negative'}}">{{stats.net>=0?'+':''}}{{stats.net}}</view><view class="line"><text>参与局数</text><text>{{stats.hands}}</text></view><view class="line"><text>和牌</text><text>{{stats.wins}}次 · 自摸{{stats.tsumo}} / 荣和{{stats.ron}}</text></view><view class="line"><text>被胡</text><text>{{stats.hit}}次</text></view><view class="line"><text>放铳</text><text>{{stats.dealin}}局</text></view></view><view class="card" wx:if="{{stats}}"><view class="heading">同桌收支</view><view wx:if="{{stats.best}}" class="line"><text>赢得最多 · {{stats.best.name}}</text><text class="positive">+{{stats.best.net}}</text></view><view wx:if="{{stats.worst}}" class="line"><text>输得最多 · {{stats.worst.name}}</text><text class="negative">{{stats.worst.net}}</text></view><view wx:for="{{stats.peers}}" wx:key="id" class="line"><view class="row"><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}"/><text>{{item.name}} · {{item.hands}}局</text></view><text class="{{item.net>=0?'positive':'negative'}}">{{item.net>=0?'+':''}}{{item.net}}</text></view><view wx:if="{{!stats.peers.length}}" class="empty">这个月还没有牌局</view></view></view>
