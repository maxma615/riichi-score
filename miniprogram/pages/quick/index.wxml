<view class="page quick-page">
  <view class="card lookup-card">
    <view class="lookup-heading"><view class="heading">符番速查</view><text class="lookup-mark">点数</text></view>
    <view class="quick-context">
      <view><view class="context-label">桌型</view><view class="switch-pair"><button data-key="players" data-value="{{4}}" class="{{quick.players===4?'selected':''}}" bindtap="choose">四人</button><button data-key="players" data-value="{{3}}" class="{{quick.players===3?'selected':''}}" bindtap="choose">三人</button></view></view>
      <view><view class="context-label">本场</view><view class="counter"><button data-step="-1" bindtap="honba" disabled="{{quick.honba===0}}" aria-label="减少一本场">−</button><text>{{quick.honba}} 本场</text><button data-step="1" bindtap="honba" disabled="{{quick.honba===100}}" aria-label="增加一本场">＋</button></view></view>
    </view>
    <view class="switches">
      <view class="switch-pair"><button class="{{!quick.dealer?'selected':''}}" data-key="dealer" data-value="{{false}}" bindtap="choose">闲家</button><button class="{{quick.dealer?'selected':''}}" data-key="dealer" data-value="{{true}}" bindtap="choose">庄家</button></view>
      <view class="switch-pair"><button class="{{quick.method==='ron'?'selected':''}}" data-key="method" data-value="ron" bindtap="choose">荣和</button><button class="{{quick.method==='tsumo'?'selected':''}}" data-key="method" data-value="tsumo" bindtap="choose">自摸</button></view>
    </view>
    <view class="result" aria-live="polite"><view wx:if="{{result}}"><view class="selection-label">{{quick.dealer?'庄家':'闲家'}} · {{result.selection}}</view><view class="score">{{result.totalText}}<text> 点</text></view><view class="payment">{{result.payment}}</view></view><view wx:else>{{error}}</view></view>
    <view class="table-caption"><text>{{legend}}</text><text>{{quick.players}}人 · {{quick.honba}}本场</text></view>
    <view class="matrix-head"><view>符 / 番</view><view wx:for="{{columns}}" wx:key="han" class="{{item.selected?'axis-selected':''}}">{{item.han}}番</view></view>
    <view wx:for="{{rows}}" wx:for-item="row" wx:key="fu" class="matrix-row"><view class="fu-axis {{row.selected?'axis-selected':''}}">{{row.fu}}符</view><button wx:for="{{row.cells}}" wx:for-item="cell" wx:key="han" class="point-cell {{!quick.yakuman && quick.han &lt;= 4 && (quick.fu===cell.fu || quick.han===cell.han)?'axis-tint':''}} {{cell.selected?'chosen':''}}" disabled="{{!cell.valid}}" data-fu="{{cell.fu}}" data-han="{{cell.han}}" data-yakuman="{{cell.yakuman}}" bindtap="selectCell" aria-label="{{cell.han}}番{{cell.fu}}符 {{cell.main}} {{cell.sub}}"><view class="cell-main">{{cell.main}}</view><view wx:if="{{cell.sub}}" class="cell-sub">{{cell.sub}}</view></button></view>
    <view class="limit-heading">5番及以上 · 满贯与役满</view>
    <button wx:for="{{limits}}" wx:key="han" class="limit-row {{item.selected?'limit-selected':''}}" data-fu="{{item.fu}}" data-han="{{item.han}}" data-yakuman="{{item.yakuman}}" bindtap="selectCell"><text>{{item.title}}</text><text>{{item.label}}</text><view class="limit-value {{item.selected?'chosen':''}}"><view class="cell-main">{{item.main}}</view><view wx:if="{{item.sub}}" class="cell-sub">{{item.sub}}</view></view></button>
    <button class="more-toggle" data-key="more" bindtap="toggle">多倍役满 {{more?'收起':'展开'}}</button>
    <view wx:if="{{more}}"><button wx:for="{{yakumans}}" wx:key="yakuman" class="limit-row {{item.selected?'limit-selected':''}}" data-fu="{{item.fu}}" data-han="{{item.han}}" data-yakuman="{{item.yakuman}}" bindtap="selectCell"><text>{{item.title}}</text><view class="limit-value {{item.selected?'chosen':''}}"><view class="cell-main">{{item.main}}</view><view wx:if="{{item.sub}}" class="cell-sub">{{item.sub}}</view></view></button></view>

  </view>
</view>
