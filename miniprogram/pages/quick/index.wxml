<view class="page"><view class="title">符番速查</view><view class="card"><view class="result"><view wx:if="{{result}}"><view>{{result.label}}</view><view class="score">{{result.total}} 点</view><view>{{result.payment}}</view></view><view wx:else>{{error}}</view></view><view class="row"><view class="chip {{quick.players===4?'selected':''}}" data-key="players" data-value="{{4}}" bindtap="choose">四人</view><view class="chip {{quick.players===3?'selected':''}}" data-key="players" data-value="{{3}}" bindtap="choose">三人</view></view><view class="row"><view class="chip {{!quick.dealer?'selected':''}}" data-key="dealer" data-value="{{false}}" bindtap="choose">闲家</view><view class="chip {{quick.dealer?'selected':''}}" data-key="dealer" data-value="{{true}}" bindtap="choose">庄家</view><view class="chip {{quick.method==='ron'?'selected':''}}" data-key="method" data-value="ron" bindtap="choose">荣和</view><view class="chip {{quick.method==='tsumo'?'selected':''}}" data-key="method" data-value="tsumo" bindtap="choose">自摸</view></view><view class="label">番数</view><view class="row"><view wx:for="{{han}}" wx:key="*this" class="chip {{quick.han===item?'selected':''}}" data-key="han" data-value="{{item}}" bindtap="choose">{{item}}番</view></view><view class="label">符数</view><view class="row"><view wx:for="{{fu}}" wx:key="*this" class="chip {{quick.fu===item?'selected':''}}" data-key="fu" data-value="{{item}}" bindtap="choose">{{item}}符</view></view><view class="label">本场</view><input type="number" value="{{quick.honba}}" bindinput="honba"/></view><view class="card"><view class="heading">1–4番</view><view class="line"><text>符</text><text>1番</text><text>2番</text><text>3番</text><text>4番</text></view><view wx:for="{{rows}}" wx:key="fu" class="line"><text>{{item.fu}}</text><text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="index">{{cell}}</text></view><view class="small">自摸：闲家 / 庄家；ALL：每家</view></view><view class="card"><view class="heading">满贯与役满</view><view wx:for="{{limits}}" wx:key="label" class="line"><text>{{item.label}}</text><text>{{item.value}}</text></view></view></view>
