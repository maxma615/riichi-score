<view class="page"><view class="title">记一局</view><view class="card"><view class="record-status"><text>{{room.honba}} 本场</text><view>{{status.label}} · 庄家 {{status.dealerName}}</view></view><view class="row"><view class="chip {{kind==='win'?'selected':''}}" data-key="kind" data-value="win" bindtap="choose">和牌</view><view class="chip {{kind==='draw'?'selected':''}}" data-key="kind" data-value="draw" bindtap="choose">荒牌流局</view><view class="chip {{kind==='abort'?'selected':''}}" data-key="kind" data-value="abort" bindtap="choose">途中流局</view></view><block wx:if="{{kind==='win'}}"><view class="row"><view class="chip {{method==='tsumo'?'selected':''}}" data-key="method" data-value="tsumo" bindtap="choose">自摸</view><view class="chip {{method==='ron'?'selected':''}}" data-key="method" data-value="ron" bindtap="choose">荣和</view></view><block wx:if="{{method==='ron'}}"><view class="label">放铳的人</view><picker range="{{names}}" value="{{loser}}" data-key="loser" bindchange="picker">{{names[loser]}}</picker></block><view class="label">{{method==='ron'?'谁荣和了？':'谁自摸了？'}}</view><view class="row winner-picker"><button wx:for="{{names}}" wx:key="index" data-seat="{{index}}" bindtap="selectWinner" aria-pressed="{{winnerFlags[index]}}" class="{{winnerFlags[index]?'selected':''}}" disabled="{{method==='ron' && (index===loser || (!winnerFlags[index] && winners.length>=2))}}">{{item}}</button></view><block wx:for="{{winForms}}" wx:key="seat" wx:for-index="seatIndex"><view wx:if="{{winnerFlags[seatIndex]}}"><view class="heading">{{names[seatIndex]}}</view><view class="label">番数</view><view class="counter record-counter"><button data-seat="{{seatIndex}}" data-step="-1" bindtap="stepHan" disabled="{{item.han&lt;=1}}" aria-label="减少一番">−</button><text>{{item.han}} 番</text><button data-seat="{{seatIndex}}" data-step="1" bindtap="stepHan" disabled="{{item.han&gt;=100}}" aria-label="增加一番">＋</button></view><view class="label">符数</view><view class="fu-choices"><button wx:for="{{fuChoices[seatIndex]}}" wx:for-item="choice" wx:key="index" data-seat="{{seatIndex}}" data-index="{{choice.index}}" bindtap="chooseFu" disabled="{{!choice.valid}}" class="{{item.fuIndex===choice.index?'selected':''}}">{{choice.fu}}符</button></view><view class="label">役满</view><picker range="{{yakumans}}" value="{{item.yakuman}}" data-key="yakuman" data-seat="{{seatIndex}}" bindchange="picker">{{yakumans[item.yakuman]}}</picker></view></block></block><view class="label">本局立直的人</view><checkbox-group data-key="riichi" bindchange="check"><label wx:for="{{names}}" wx:key="index"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group><block wx:if="{{kind==='draw'}}"><view class="label">听牌的人</view><checkbox-group data-key="tenpai" bindchange="check"><label wx:for="{{names}}" wx:key="index"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group></block></view><view class="card"><block wx:if="{{details.winning && preview}}"><view class="heading">每人最终支付</view><view class="payment-head"><text>玩家</text><text>基础点数</text><text>本场加点</text><text>最终支付</text></view><view wx:for="{{details.rows}}" wx:key="seat" class="payment-row"><text>{{item.name}}</text><text>{{item.base}}</text><text>+{{item.bonus}}</text><text class="payment-total">{{item.total}}</text></view><view wx:for="{{details.transfers}}" wx:key="index" class="payment-transfer">{{item.fromName}} → {{item.toName}}：{{item.base}} + {{item.bonus}} = {{item.total}}</view><view wx:if="{{details.potIncome}}">供托收入：{{details.potIncome}} 点</view></block><view class="heading">本局收支</view><view wx:for="{{preview}}" wx:key="name" class="line"><text>{{item.name}}<text wx:if="{{item.riichi}}"> · 立直支出 {{item.riichi}}</text></text><text class="{{item.positive?'positive':'negative'}}">{{item.positive?'+':''}}{{item.value}}</text></view><view wx:if="{{preview}}" class="next-round">记分后：{{details.next.honba}} 本场 · {{details.next.dealerName}} {{details.next.label}}</view><view wx:if="{{error}}">{{error}}</view><button class="primary" bindtap="save" disabled="{{saving || !preview}}" loading="{{saving}}">确认记分</button></view></view>
