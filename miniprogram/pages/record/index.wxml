<view class="page"><view class="title">记一局</view><view class="card"><view class="row"><view class="chip {{kind==='win'?'selected':''}}" data-key="kind" data-value="win" bindtap="choose">和牌</view><view class="chip {{kind==='draw'?'selected':''}}" data-key="kind" data-value="draw" bindtap="choose">荒牌流局</view><view class="chip {{kind==='abort'?'selected':''}}" data-key="kind" data-value="abort" bindtap="choose">途中流局</view></view><block wx:if="{{kind==='win'}}"><view class="row"><view class="chip {{method==='tsumo'?'selected':''}}" data-key="method" data-value="tsumo" bindtap="choose">自摸</view><view class="chip {{method==='ron'?'selected':''}}" data-key="method" data-value="ron" bindtap="choose">荣和</view></view><view class="label">和牌的人</view><checkbox-group data-key="winners" bindchange="check"><label wx:for="{{names}}" wx:key="index"><checkbox value="{{index}}" checked="{{winnerFlags[index]}}"/>{{item}}</label></checkbox-group><block wx:if="{{method==='ron'}}"><view class="label">放铳的人</view><picker range="{{names}}" value="{{loser}}" data-key="loser" bindchange="picker">{{names[loser]}}</picker></block><block wx:for="{{winForms}}" wx:key="index"><view wx:if="{{winnerFlags[index]}}"><view class="heading">{{names[index]}}</view><view class="label">番数</view><input type="number" value="{{item.han}}" data-key="han" data-seat="{{index}}" bindinput="picker"/><view class="label">符数</view><picker range="{{fu}}" value="{{item.fuIndex}}" data-key="fuIndex" data-seat="{{index}}" bindchange="picker">{{fu[item.fuIndex]}}符</picker><view class="label">役满倍数（普通和牌填0）</view><input type="number" value="{{item.yakuman}}" data-key="yakuman" data-seat="{{index}}" bindinput="picker"/></view></block></block><view class="label">本局立直的人</view><checkbox-group data-key="riichi" bindchange="check"><label wx:for="{{names}}" wx:key="index"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group><block wx:if="{{kind==='draw'}}"><view class="label">听牌的人</view><checkbox-group data-key="tenpai" bindchange="check"><label wx:for="{{names}}" wx:key="index"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group></block></view><view class="card"><view class="heading">本局收支</view><view wx:for="{{preview}}" wx:key="name" class="line"><text>{{item.name}}</text><text class="{{item.positive?'positive':'negative'}}">{{item.positive?'+':''}}{{item.value}}</text></view><view wx:if="{{error}}">{{error}}</view><button class="primary" bindtap="save" disabled="{{saving || !preview}}" loading="{{saving}}">确认记分</button></view></view>
