<view class="page fu-page"><view class="title">算符</view><view class="fu-summary" wx:if="{{result}}"><view><view class="score">{{result.fu}}符</view><view class="small">{{result.raw}}符 · {{form.special==='normal'?'向上取整':'固定符数'}}</view></view><button class="primary" bindtap="use">用这个符数查点</button></view><view class="card"><view class="row"><view class="chip {{form.method==='ron'?'selected':''}}" data-key="method" data-value="ron" bindtap="choose">荣和</view><view class="chip {{form.method==='tsumo'?'selected':''}}" data-key="method" data-value="tsumo" bindtap="choose">自摸 +2符</view></view><view class="row"><view class="chip {{form.closed?'selected':''}}" data-key="closed" data-value="{{true}}" bindtap="choose">{{form.method==='ron'?'门前清荣和 +10符':'门前清'}}</view><view class="chip {{!form.closed?'selected':''}}" data-key="closed" data-value="{{false}}" bindtap="choose">副露</view></view><view class="label">牌型</view><view class="row"><view class="chip {{form.special==='normal'?'selected':''}}" data-key="special" data-value="normal" bindtap="choose">普通牌型</view><view class="chip {{form.special==='chiitoitsu'?'selected':''}}" data-key="special" data-value="chiitoitsu" bindtap="choose">七对子 25符</view><view class="chip {{form.special==='pinfu'?'selected':''}}" data-key="special" data-value="pinfu" bindtap="choose">{{form.method==='tsumo'?'平和自摸 20符':'平和荣和 30符'}}</view></view><block wx:if="{{form.special==='normal'}}"><view class="label">雀头（对子）</view><view class="row"><view class="chip {{form.pair===0?'selected':''}}" data-key="pair" data-value="{{0}}" bindtap="choose">非役牌 +0符</view><view class="chip {{form.pair===2?'selected':''}}" data-key="pair" data-value="{{2}}" bindtap="choose">役牌 +2符</view><view class="chip {{form.pair===4?'selected':''}}" data-key="pair" data-value="{{4}}" bindtap="choose">连风（自风＋场风） +4符</view></view><view class="label">听牌形</view><view class="row"><view class="chip {{form.wait===0?'selected':''}}" data-key="wait" data-value="{{0}}" bindtap="choose">两面 / 双碰 +0符</view><view class="chip {{form.wait===2?'selected':''}}" data-key="wait" data-value="{{2}}" bindtap="choose">边张 / 嵌张 / 单骑 +2符</view></view><view class="label">刻子与杠子</view><view wx:for="{{form.melds}}" wx:key="id"><picker range="{{types}}" value="{{item.index}}" data-index="{{index}}" bindchange="type">{{types[item.index]}}</picker><view class="row"><text>幺九牌／字牌</text><switch checked="{{item.terminal}}" data-index="{{index}}" bindchange="terminal"/><button data-index="{{index}}" bindtap="remove">移除</button></view></view><button bindtap="add" wx:if="{{form.melds.length<4}}">添加刻子 / 杠子</button><view class="small">中张 / 幺九牌／字牌：明刻 2/4 · 暗刻 4/8 · 明杠 8/16 · 暗杠 16/32</view></block></view><view class="card" wx:if="{{result}}"><view wx:for="{{result.items}}" wx:key="index" class="line"><text>{{item.label}}</text><text>+{{item.value}}符</text></view></view><view class="card" wx:else>{{error}}</view></view>
