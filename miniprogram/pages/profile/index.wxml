<view class="page"><view class="title">头像与昵称</view><view class="card"><button open-type="chooseAvatar" bindchooseavatar="choose"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}"/><text wx:else>选择微信头像</text></button><view class="label">昵称</view><input type="nickname" maxlength="24" value="{{name}}" bindinput="name" bindblur="name" placeholder="填写昵称"/><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button></view></view>
