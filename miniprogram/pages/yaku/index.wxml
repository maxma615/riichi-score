<view class="page"><view class="card"><view class="heading">役种查番</view><input type="text" value="{{query}}" bindinput="search" placeholder="搜索役名或条件"/><view class="row"><button wx:for="{{groups}}" wx:key="*this" data-group="{{item}}" bindtap="choose" class="{{group===item?'selected':''}}">{{item}}</button></view><view wx:for="{{items}}" wx:key="name" class="yaku-item"><view class="row"><text class="yaku-name">{{item.name}}</text><text class="small">门清 {{item.closedLabel}} · {{item.open===null?item.openLabel:'副露 '+item.openLabel}}</text></view><view class="small">{{item.description}}</view></view><view wx:if="{{!items.length}}">没有找到，换个关键词试试。</view><view class="small">宝牌、赤宝牌、里宝牌、拔北宝牌各加1番，和牌须另有役。</view></view></view>
