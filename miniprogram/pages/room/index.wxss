.rule-options { margin: 12rpx 0 20rpx; }
.rule-option { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 100rpx; margin: 0; padding: 16rpx 0; border: 0; border-bottom: 1rpx solid #c0b29766; border-radius: 0; background: transparent; color: #292d2b; text-align: left; line-height: 1.4; }
.rule-option::after { border: 0; }
.rule-option:last-child { border-bottom: 0; }
.rule-copy { display: flex; flex-direction: column; gap: 4rpx; }
.rule-name { font-size: 28rpx; font-weight: 500; }
.rule-note { font-size: 22rpx; color: #817463; }
.rule-switch { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; font-size: 22rpx; color: #817463; }
.switch-track { position: relative; width: 72rpx; height: 44rpx; border-radius: 24rpx; background: #c2b8a7; transition: background 160ms ease; }
.switch-knob { position: absolute; left: 6rpx; top: 6rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: #faf5ea; box-shadow: 0 2rpx 6rpx #292d2b26; transition: transform 160ms ease; }
.is-on .rule-switch { color: #993e31; }
.is-on .switch-track { background: #993e31; }
.is-on .switch-knob { transform: translateX(28rpx); }

.sort-overlay{position:fixed;inset:0;background:#0008;z-index:90;display:flex;align-items:center;padding:28rpx;}.sort-overlay>.card{width:100%;}.order-seat{display:flex;align-items:center;gap:12rpx;}.order-seat text{flex:1;}.order-seat button{margin:6rpx;min-width:80rpx;}
.ranking-row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #c0b29766;}.ranking-row>text:nth-child(2){flex:1;}.ranking-row>view{text-align:right;}.rank-number{font:44rpx serif;color:#993e31;}.rematch-button{margin-top:30rpx;}.room-management .delete-button{color:#993e31;background:transparent;}.sort-overlay .order-seat{position:relative;min-height:140rpx;box-sizing:border-box;border:1rpx solid #c0b297;background:#ede6d7;border-radius:10rpx;padding:16rpx;margin:14rpx 0;transition:transform 160ms ease;}.sort-overlay .dragging{z-index:3;background:#f7efde;border-color:#993e31;box-shadow:0 16rpx 30rpx #171b1b33;transition:none;}.order-seat .order-number{flex:0 0 36rpx;font:40rpx serif;opacity:.5;}.drag-handle{width:66rpx;text-align:center;font-size:42rpx;line-height:1;opacity:.65;}.drag-handle view{font-size:22rpx;margin-top:10rpx;}
