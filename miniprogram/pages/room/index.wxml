<view class="page"><view class="title">线下牌桌</view><view class="card"><view class="row" bindtap="profile"><image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}"/><text>{{profile.name || '我的资料'}}</text><text class="small">编辑头像与昵称</text></view></view><view wx:if="{{invite}}" class="card"><view class="heading">选择座位</view><button wx:for="{{invite.seats}}" wx:key="seat" data-seat="{{item.seat}}" bindtap="join" disabled="{{item.occupied || invite.finished || loading}}">{{item.wind}} · {{item.name}}</button><button bindtap="cancelJoin">返回</button></view><block wx:elif="{{room}}"><view class="card"><view class="heading">{{room.finished?'牌局已结束':round}} · {{room.honba}}本场</view><view class="small">供托 {{room.pot}}根</view><view class="row"><view wx:for="{{members}}" wx:key="seat" class="seat {{item.dealer?'dealer':''}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="avatar"/><view>{{item.wind}} · {{item.name || '空位'}} {{item.dealer?'庄':''}}</view><view class="score">{{item.score}}</view><view class="{{item.delta>=0?'positive':'negative'}}">{{item.delta>=0?'+':''}}{{item.delta}}</view><button wx:if="{{item.empty && room.isOwner}}" data-seat="{{item.seat}}" bindtap="add">填写玩家</button></view></view><button bindtap="share">扫码入桌</button><button open-type="share">发送邀请</button><button wx:if="{{room.isOwner && !room.finished}}" class="primary" bindtap="record">记一局</button><view wx:if="{{room.isOwner}}" class="toolbar"><button disabled="{{loading || !room.history.length}}" bindtap="undo">撤回最近记录</button><button wx:if="{{!room.finished}}" disabled="{{loading}}" bindtap="finish">结束牌局</button></view><button wx:if="{{room.finished}}" bindtap="another">另开一桌</button></view><view class="card" wx:if="{{qr}}"><image class="qr" src="{{qr}}"/><button bindtap="closeQr">收起</button></view><view class="card"><view class="heading">每圈收支</view><view wx:for="{{circles}}" wx:key="label"><view>{{item.label}}</view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="name" class="line"><text>{{change.name}}</text><text class="{{change.positive?'positive':'negative'}}">{{change.value}}</text></view></view></view><view class="card"><view class="heading">逐局记录</view><view wx:for="{{history}}" wx:key="createdAt"><view class="line"><text>{{item.label}} · {{item.honba}}本场</text><text>{{item.description}}</text></view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="name" class="line"><text>{{change.name}}</text><text class="{{change.positive?'positive':'negative'}}">{{change.value}}</text></view></view></view></block><view wx:else class="card"><view class="row"><text>切上满贯</text><switch checked="{{kiriage}}" data-key="kiriage" bindchange="rule"/></view><view class="row"><text>累计役满</text><switch checked="{{kazoe}}" data-key="kazoe" bindchange="rule"/></view><button class="primary" data-players="{{4}}" bindtap="create" disabled="{{loading}}">开四人桌</button><button data-players="{{3}}" bindtap="create" disabled="{{loading}}">开三人桌</button><button bindtap="scan">扫码入桌</button><button bindtap="load" wx:if="{{!profile}}">连接微信</button><view class="heading">最近的牌桌</view><button wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.names}} · {{item.finished?'已结束':'进行中'}}</button></view></view>
