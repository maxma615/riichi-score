<view class="page"><view class="title">线下牌桌</view><view class="card"><view class="row" bindtap="profile"><image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}"/><text>{{profile.name || '我的资料'}}</text><text class="small">编辑头像与昵称</text></view></view><view wx:if="{{invite}}" class="card"><view class="heading">加入牌桌</view><button class="primary" bindtap="join" disabled="{{invite.finished || loading}}">加入牌桌</button><button bindtap="cancelJoin">返回</button></view><block wx:elif="{{room}}"><view class="card"><view class="heading">{{room.finished?'牌局已结束 · 本场结算':round}}</view>
<block wx:if="{{room.finished}}"><view wx:for="{{ranking}}" wx:key="seat" class="ranking-row"><text class="rank-number">{{index+1}}</text><text>{{item.name}}</text><view>{{item.score}}<view class="small">总点数</view></view><view class="{{item.delta>=0?'positive':'negative'}}">{{item.delta>0?'+':''}}{{item.delta}}<view class="small">净点数</view></view></view><button class="primary rematch-button" bindtap="rematch" disabled="{{loading}}">{{room.nextRoomId?'进入下一场牌桌':'原班人马再开一场'}}</button><view wx:if="{{room.pot}}">未领取供托 {{room.pot}}根</view></block>
<block wx:else><view class="round-status"><view class="honba-number">{{room.honba}}<text> 本场</text></view><view><view class="repeat-label">{{status.label}}</view><view class="dealer-label">{{room.dealerSelected===false?'待选择起庄玩家':'庄家 · '+status.dealerName}}</view></view></view><view class="small">供托 {{room.pot}}根</view><view class="row"><view wx:for="{{members}}" wx:key="seat" class="seat {{item.dealer?'dealer':''}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="avatar"/><view>{{item.wind}} · {{item.name || '空位'}} {{item.dealer?'庄':''}}</view><view class="score">{{item.score}}</view><view class="{{item.delta>=0?'positive':'negative'}}">{{item.delta>=0?'+':''}}{{item.delta}}</view><button wx:if="{{!room.history.length && item.empty}}" data-seat="{{item.seat}}" bindtap="add">填写玩家</button><button wx:if="{{!room.history.length && !item.empty && item.seat!==room.mySeat}}" data-seat="{{item.seat}}" bindtap="removePlayer">更换玩家</button></view></view>
<block wx:if="{{!room.history.length}}"><view class="row"><button data-rounds="1" bindtap="length" class="{{room.rules.rounds===1?'selected':''}}">东风场</button><button data-rounds="2" bindtap="length" class="{{room.rules.rounds===2?'selected':''}}">半庄 · 东南场</button></view><button bindtap="sortSeats">拖动调整顺序</button><button bindtap="selectDealer">选择起庄玩家</button></block><button bindtap="share">扫码入桌</button><button open-type="share">发送邀请</button><button class="primary" bindtap="record" disabled="{{room.dealerSelected===false || loading}}">记一局</button><button disabled="{{loading}}" bindtap="finish">结束牌局</button></block></view><view class="card" wx:if="{{qr}}"><image class="qr" src="{{qr}}"/><button bindtap="closeQr">收起</button></view><view class="card"><view class="heading">每圈收支</view><view wx:for="{{circles}}" wx:key="label"><view>{{item.label}}</view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="name" class="line"><text>{{change.name}}</text><text class="{{change.positive?'positive':'negative'}}">{{change.value}}</text></view></view></view><view class="card"><view class="heading">逐局记录</view><view wx:for="{{history}}" wx:key="createdAt"><view class="line"><text>{{item.label}} · {{item.honba}}本场</text><text>{{item.description}}</text></view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="name" class="line"><text>{{change.name}}</text><text class="{{change.positive?'positive':'negative'}}">{{change.value}}</text></view></view></view><view class="card room-management"><view class="heading">牌局管理</view><button disabled="{{loading || !room.history.length}}" bindtap="undo">撤回最近记录</button><button bindtap="another">另开不同牌桌</button><button class="delete-button" bindtap="deleteRoom" disabled="{{loading}}">删除牌局</button></view></block><view wx:else class="card"><view class="rule-options"><button class="rule-option {{kiriage?'is-on':''}}" data-key="kiriage" bindtap="rule" aria-pressed="{{kiriage}}" disabled="{{loading}}"><view class="rule-copy"><text class="rule-name">切上满贯</text><text class="rule-note">4番30符 / 3番60符</text></view><view class="rule-switch"><text>{{kiriage?'开启':'关闭'}}</text><view class="switch-track"><view class="switch-knob"/></view></view></button><button class="rule-option {{kazoe?'is-on':''}}" data-key="kazoe" bindtap="rule" aria-pressed="{{kazoe}}" disabled="{{loading}}"><view class="rule-copy"><text class="rule-name">累计役满</text><text class="rule-note">13番起</text></view><view class="rule-switch"><text>{{kazoe?'开启':'关闭'}}</text><view class="switch-track"><view class="switch-knob"/></view></view></button></view><view class="row"><button data-rounds="1" bindtap="length" class="{{rounds===1?'selected':''}}">东风场</button><button data-rounds="2" bindtap="length" class="{{rounds===2?'selected':''}}">半庄 · 东南场</button></view><button class="primary" data-players="{{4}}" bindtap="create" disabled="{{loading}}">开四人桌</button><button data-players="{{3}}" bindtap="create" disabled="{{loading}}">开三人桌</button><button bindtap="scan">扫码入桌</button><button bindtap="load" wx:if="{{!profile}}">连接微信</button><view class="heading">最近的牌桌</view><button wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.names}} · {{item.finished?'已结束':'进行中'}}</button></view><view wx:if="{{sorting}}" class="sort-overlay"><view class="card"><view class="heading">拖动调整座位顺序</view><view class="small">按出牌顺序拖动整行，保存后选择起庄玩家</view><view wx:for="{{seatOrder}}" wx:key="seat" wx:for-index="orderIndex" class="order-seat {{dragging===orderIndex?'dragging':''}}" style="transform:translateY({{item.offset}}px)" data-index="{{orderIndex}}" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragCancel"><text class="order-number">{{orderIndex+1}}</text><text>{{item.name}}</text><view class="drag-handle">⠿<view>拖动</view></view><button data-index="{{orderIndex}}" catchtouchstart="noop" bindtap="sortUp" disabled="{{orderIndex===0}}">↑</button></view><button bindtap="saveOrder" disabled="{{loading}}">保存顺序</button><button bindtap="cancelOrder">取消</button></view></view></view>
