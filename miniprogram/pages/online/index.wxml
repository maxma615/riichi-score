<view class="page online">
 <view wx:if="{{!room}}" class="card"><view class="title">联机牌桌</view><view class="toolbar"><button data-key="variant" data-value="sanma" bindtap="choose" class="{{variant==='sanma'?'primary':''}}">三人</button><button data-key="variant" data-value="yonma" bindtap="choose" class="{{variant==='yonma'?'primary':''}}">四人</button></view><view class="toolbar"><button data-key="mode" data-value="east" bindtap="choose" class="{{mode==='east'?'primary':''}}">东风战</button><button data-key="mode" data-value="hanchan" bindtap="choose" class="{{mode==='hanchan'?'primary':''}}">半庄战</button></view><button class="primary" bindtap="create" disabled="{{busy}}">创建牌桌</button><view class="join"><input maxlength="8" value="{{code}}" bindinput="code" placeholder="8位房间码"/><button bindtap="join" disabled="{{busy || code.length!==8}}">加入</button></view></view>
 <block wx:else><view class="row"><text>{{round || '等待开局'}}</text><text>{{room.code}}</text><button wx:if="{{host}}" size="mini" bindtap="finish" disabled="{{busy}}">解散</button><button wx:elif="{{room.status!=='playing'}}" size="mini" bindtap="leave" disabled="{{busy}}">离开</button></view>
 <view wx:if="{{room.status==='lobby'}}" class="card"><view wx:for="{{seats}}" wx:key="seat" class="line"><text>{{item.wind}} · {{item.name}} {{item.self?'· 你':''}}</text><text>{{item.ready?'已准备':''}}</text></view><button wx:if="{{host}}" bindtap="fill" disabled="{{busy}}">电脑补齐空位</button><button bindtap="ready" disabled="{{busy}}">{{ready?'取消准备':'准备好了'}}</button><button wx:if="{{host}}" bindtap="start" class="primary" disabled="{{busy || !allReady}}">开始对局</button><button open-type="share">邀请朋友</button></view>
 <block wx:if="{{game}}">
 <view class="table">
  <view class="dora-tray"><text>宝牌指示牌</text><view><image wx:for="{{dora}}" wx:key="index" src="{{item.src}}" class="tile-small"/></view></view>
  <view class="table-center"><view class="round">{{round}}</view><view class="remaining">余 {{game.remainingTiles}}</view><view>本场 {{game.honba}} · 供托 {{game.riichiSticks}}</view></view>
  <block wx:for="{{seats}}" wx:for-item="player" wx:key="seat">
   <view class="player-label label-{{player.edge}} {{player.active?'active':''}}"><text class="wind">{{player.wind}}</text><view><text>{{player.name}}</text><text class="player-score">{{player.score}}</text></view><text wx:if="{{player.riichi}}" class="call">立直</text></view>
   <view wx:if="{{!player.self}}" class="opponent opponent-{{player.edge}}"><view class="backs"><view wx:for="{{player.hidden}}" wx:key="*this" class="back"/></view></view>
   <view class="river river-{{player.edge}}"><image wx:for="{{player.river}}" wx:key="index" src="{{item.src}}" class="tile-small {{index===player.river.length-1?'latest':''}}"/></view>
   <view class="exposed exposed-{{player.edge}}">
    <view class="melds"><view wx:for="{{player.melds}}" wx:for-item="set" wx:key="index" class="meld"><view wx:for="{{set}}" wx:key="index" class="meld-tile {{item.called?'called':''}} {{item.added?'added':''}} {{item.back?'back':''}}"><image wx:if="{{!item.back}}" src="{{item.src}}" class="tile-small"/></view></view></view>
    <view wx:if="{{player.nuki}}" class="north-tray"><text>拔北 {{player.nuki}}</text><image wx:for="{{player.north}}" wx:key="index" src="{{item.src}}" class="tile-small"/></view>
   </view>
  </block>
  <view class="hand"><view wx:for="{{hand}}" wx:key="id" data-index="{{index}}" bindtap="discard" bindtouchstart="touchStart" catchtouchend="touchEnd" bindtouchcancel="touchCancel" class="tile {{selected===item.id?'raised':''}} {{item.choiceId?'playable':''}} {{item.drawn?'drawn':''}}"><image src="{{item.src}}"/></view></view>
  <view class="actions"><button wx:for="{{actions}}" wx:key="id" data-id="{{item.id}}" bindtap="respond" disabled="{{busy}}"><text>{{item.label}}</text><view class="action-tiles"><image wx:for="{{item.tiles}}" wx:key="index" src="{{item.src}}" class="tile-small"/></view></button></view>
  <view wx:if="{{announcement}}" class="announcement"><text>{{announcement.name}}</text><view>{{announcement.text}}</view></view>
 </view>
 <view wx:if="{{settlement}}" class="card"><view class="heading">{{settlement.name}}</view><view wx:if="{{settlement.kind==='win'}}">{{settlement.han}}番 {{settlement.fu}}符 · {{settlement.points}}点</view><view wx:for="{{settlement.yaku}}" wx:key="name" class="line"><text>{{item.name}}</text><text>{{item.han}}番</text></view><view wx:for="{{settlement.changes}}" wx:key="seat" class="line"><text>{{item.name}}</text><text class="{{item.value>=0?'positive':'negative'}}">{{item.value>0?'+':''}}{{item.value}}</text></view></view><view wx:if="{{game.ranking}}" class="card"><view class="heading">最终排名</view><view wx:for="{{game.ranking}}" wx:key="seat" class="line"><text>{{item.rank}}位 · {{seats[item.seat].name}}</text><text>{{item.score}}</text></view><button wx:if="{{host}}" bindtap="rematch" disabled="{{busy}}">再来一场</button></view></block></block>
</view>
