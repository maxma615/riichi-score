<view class="page online {{game?'is-playing':''}}" style="--safe-left:{{safeInsets.left}}px;--safe-right:{{safeInsets.right}}px;--own-meld-offset:{{ownMeldCount*40}}px;">
  <view wx:if="{{!room}}" class="card table-entry"
    ><view class="title">联机牌桌</view
    ><view class="toolbar"
      ><button
        data-key="variant"
        data-value="sanma"
        bindtap="choose"
        class="{{variant==='sanma'?'primary':''}}"
      >
        三人</button
      ><button
        data-key="variant"
        data-value="yonma"
        bindtap="choose"
        class="{{variant==='yonma'?'primary':''}}"
      >
        四人
      </button></view
    ><view class="toolbar"
      ><button
        data-key="mode"
        data-value="east"
        bindtap="choose"
        class="{{mode==='east'?'primary':''}}"
      >
        东风战</button
      ><button
        data-key="mode"
        data-value="hanchan"
        bindtap="choose"
        class="{{mode==='hanchan'?'primary':''}}"
      >
        半庄战
      </button></view
    ><button class="primary" bindtap="create" disabled="{{busy}}">
      创建牌桌</button
    ><view class="join"
      ><input
        maxlength="8"
        value="{{code}}"
        bindinput="code"
        placeholder="8位房间码"
      /><button bindtap="join" disabled="{{busy || code.length!==8}}">
        加入
      </button></view
    ></view
  >
  <block wx:else
    ><view class="row"
      ><text>{{round || '等待开局'}}</text>
      <view wx:if="{{game && doraVisible}}" class="dora-tray drag-exclusion">
        <text>宝牌指示牌</text><view><image wx:for="{{dora}}" wx:key="index" src="{{item.src}}" class="tile-small" /></view>
      </view><text>{{room.code}}</text
      ><button size="mini" bindtap="toggleSound">{{soundEnabled?'声音 开':'声音 关'}}</button><button
        wx:if="{{host}}"
        size="mini"
        bindtap="finish"
        disabled="{{busy}}"
      >
        解散</button
      ><button
        wx:elif="{{room.status!=='playing'}}"
        size="mini"
        bindtap="leave"
        disabled="{{busy}}"
      >
        离开
      </button></view
    >
    <view wx:if="{{room.status==='lobby'}}" class="card table-lobby"
      ><view wx:for="{{seats}}" wx:key="seat" class="line"
        ><text>{{item.wind}} · {{item.name}} {{item.self?'· 你':''}}</text
        ><text>{{item.ready?'已准备':''}}</text></view
      ><button wx:if="{{host}}" bindtap="fill" disabled="{{busy}}">
        电脑补齐空位</button
      ><button bindtap="ready" disabled="{{busy}}">
        {{ready?'取消准备':'准备好了'}}</button
      ><button
        wx:if="{{host}}"
        bindtap="start"
        class="primary"
        disabled="{{busy || !allReady}}"
      >
        开始对局</button
      ><button open-type="share">邀请朋友</button></view
    >
    <block wx:if="{{game}}">
      <view class="table {{dropTarget?'is-drop-target':''}} {{table3dReady?'is-webgl':''}}">
        <canvas id="table-webgl" canvas-id="table-webgl" type="2d" hidden="{{(settlement && settlement.visible) || game.ranking}}" class="{{table3dBitmap?'table-webgl-buffer':'table-webgl'}}" disable-scroll="{{true}}" />
        <image wx:if="{{table3dBitmap && table3dFrame}}" class="table-webgl" src="{{table3dFrame}}" mode="scaleToFill" />
        <view class="table-center drag-exclusion" style="{{table3dReady?table3dCenterStyle:''}}"
          ><view class="round">{{round}}</view
          ><view class="remaining">余 {{game.remainingTiles}}</view
          ><view>本场 {{game.honba}} · 供托 {{game.riichiSticks}}</view></view
        >
        <block wx:for="{{seats}}" wx:for-item="player" wx:key="seat">
          <view
            class="drag-exclusion player-label label-{{player.edge}} {{player.active?'active':''}} {{player.nuki?'has-north':''}}"
            ><text class="wind">{{player.wind}}</text
            ><view
              ><text>{{player.name}}</text
              ><text class="player-score">{{player.score}}</text>
            <view wx:if="{{player.nuki}}" class="north-tray"
              ><text>拔北 {{player.nuki}}</text
              ><view
                wx:for="{{player.north}}"
                wx:key="index"
                id="{{item.nodeId}}"
                class="north-slot {{motionTarget===item.nodeId?(flight?'arrival-held':'arrival-pulse'):''}}"
              ><image src="{{item.src}}" class="tile-small" /></view></view>
            </view
            ><text wx:if="{{player.riichi}}" class="call">立直</text></view
          >
          <view class="seat-rack seat-rack-{{player.edge}} meld-count-{{player.melds.length}}">
          <view
            wx:if="{{!player.self}}"
            class="{{table3dReady?'':'drag-exclusion'}} opponent opponent-{{player.edge}}"
            ><view wx:if="{{settlement.tableReveals[player.seat]}}" class="revealed-rack {{settlement.tableReveals[player.seat].animate?'is-turning':''}}">
              <view wx:for="{{settlement.tableReveals[player.seat].hand}}" wx:key="index" class="revealed-tile"><image src="{{item.src}}" /></view>
            </view><view wx:else class="backs"
              ><view
                wx:for="{{player.hidden}}"
                wx:key="*this"
                class="back {{item>=player.visibleCount?'deal-pending':openingHolding?'dealt':''}}" /></view
          ></view>
          <view class="{{table3dReady?'':'drag-exclusion'}} exposed exposed-{{player.edge}} meld-count-{{player.melds.length}} {{player.hasKan?'has-kan':''}}">
            <view class="melds"
              ><view
                wx:for="{{player.melds}}"
                wx:for-item="set"
                wx:key="index"
                class="meld"
                ><view
                  wx:for="{{set}}"
                  wx:key="index"
                  id="{{item.nodeId}}"
                  style="{{item.stackStyle}}" class="meld-tile {{item.called?'called':''}} {{item.added?'added':''}} {{item.back?'back':''}} {{motionTarget===item.nodeId?(flight?'arrival-held':'arrival-pulse'):''}}"
                  ><image
                    wx:if="{{!item.back}}"
                    src="{{item.src}}"
                    class="tile-small" /></view></view
            ></view>

          </view>
          </view>
          <view class="river river-{{player.edge}} {{player.river.length>18?'is-long':''}}"
            ><view
              wx:for="{{player.riverRows}}"
              wx:for-item="row"
              wx:key="index"
              class="river-row"
              ><view
                wx:for="{{row}}"
                wx:key="index"
                id="{{item.nodeId}}"
                class="river-slot {{motionTarget===item.nodeId && flight?'arrival-held':''}} {{item.sideways?'sideways':''}}"
                ><image src="{{item.src}}" class="tile-small" /></view></view
          ></view>
        </block>
        <view class="hand drag-exclusion {{draggingId>=0?'has-drag':''}}"
          ><view
            wx:for="{{hand}}"
            wx:key="physicalKey"
            data-index="{{index}}"
            bindtap="discard"
            bindtouchstart="touchStart"
            catchtouchmove="touchMove"
            catchtouchend="touchEnd"
            bindtouchcancel="touchCancel"
            style="{{draggingId===item.id?dragStyle:''}}"
            class="tile {{draggingId===item.id?'is-dragging':''}} {{!item.dealVisible?'deal-pending':openingHolding?'dealt':''}} {{riichiMode && !item.choiceId?'locked':''}} {{selected===item.id?'raised':''}} {{item.choiceId?'playable':''}} {{item.drawn?'drawn':''}}"
            ><image src="{{item.src}}" /></view
        ></view>
        <view class="actions"
          ><button
            wx:if="{{canRiichi}}"
            bindtap="toggleRiichi"
            class="drag-exclusion {{riichiMode?'riichi-active':''}}"
            disabled="{{busy || openingHolding}}"
          >
            {{riichiMode?'取消立直':'立直'}}</button
          ><button
            wx:for="{{actions}}"
            wx:key="id"
            class="drag-exclusion"
            data-id="{{item.id}}"
            bindtap="respond"
            disabled="{{busy || openingHolding}}"
          >
            <text>{{item.label}}</text
            ><view class="action-tiles"
              ><image
                wx:for="{{item.tiles}}"
                wx:key="index"
                src="{{item.src}}"
                class="tile-small"
            /></view></button
        ></view>
        <view wx:for="{{settlement.declarations}}" wx:key="seat" class="draw-declaration declaration-{{item.edge}}"><image wx:if="{{item.art}}" src="{{item.art}}" /><text wx:else>{{item.text}}</text><view>{{item.name}}</view></view>
        <view wx:if="{{announcement}}" class="announcement"
          ><text>{{announcement.name}}</text
          ><view><image wx:if="{{announcement.art}}" src="{{announcement.art}}" /><text wx:else>{{announcement.text}}</text></view></view
        >
      </view>
      <view
        wx:if="{{(settlement && settlement.visible) || game.ranking}}"
        class="result-overlay drag-exclusion"
      >
        <view class="result-panel {{settlement.kind==='win' && settlement.stage!=='scores'?'is-win-detail':''}}">
          <scroll-view class="result-scroll" scroll-y="{{true}}" scroll-into-view="{{game.ranking?'result-ranking':settlement.scrollAnchor}}">
          <view id="{{game.ranking?'result-ranking':settlement.anchor}}"></view>
          <block wx:if="{{game.ranking}}"
            ><view class="heading">最终排名</view
            ><view wx:for="{{ranking.rows}}" wx:key="seat" class="line ranking-row {{item.visible?'is-visible':'is-pending'}} {{item.self?'is-own':''}}"
              ><text>{{item.rank}}位 · {{item.name}}{{item.self?' · 你':''}}</text
              ><text>{{item.scoreLabel}} 点</text></view
            ></block
          >
          <block wx:else>
            <view class="result-title"><image wx:if="{{settlement.titleArt}}" src="{{settlement.titleArt}}" /><text wx:else>{{settlement.title}}</text></view
            ><view class="result-subtitle"
              >{{settlement.winner}} {{settlement.progress}}</view
            >
            <block wx:if="{{settlement.stage!=='scores'}}">
              <view wx:if="{{settlement.hand.length}}" class="winning-rack"
                ><image
                  wx:for="{{settlement.hand}}"
                  wx:key="index"
                  src="{{item.src}}"
                  class="tile-small" /><image
                  wx:if="{{settlement.winningTile}}"
                  src="{{settlement.winningTile.src}}"
                  class="tile-small winning-tile" /><view
                  wx:for="{{settlement.exposed}}"
                  wx:for-item="set"
                  wx:key="index"
                  class="meld"
                  ><view
                    wx:for="{{set}}"
                    wx:key="index"
                    style="{{item.stackStyle}}" class="meld-tile {{item.called?'called':''}} {{item.added?'added':''}} {{item.back?'back':''}} {{motionTarget===item.nodeId?(flight?'arrival-held':'arrival-pulse'):''}}"
                    ><image
                      wx:if="{{!item.back}}"
                      src="{{item.src}}"
                      class="tile-small" /></view></view
              ></view>
              <view
                wx:if="{{settlement.kind==='win'}}"
                class="result-indicators"
                ><view
                  ><text>宝牌指示牌</text
                  ><view
                    ><image
                      wx:for="{{settlement.dora}}"
                      wx:key="index"
                      src="{{item.src}}"
                      class="tile-small" /></view></view
                ><view wx:if="{{settlement.ura.length}}"
                  ><text>里宝牌指示牌</text
                  ><view
                    ><image
                      wx:for="{{settlement.ura}}"
                      wx:key="index"
                      src="{{item.src}}"
                      class="tile-small" /></view></view
              ></view>
              <view
                wx:for="{{settlement.yaku}}"
                wx:key="index"
                id="result-yaku-{{index}}" class="line result-yaku {{item.current?'is-current':''}} {{item.visible?'is-visible':'is-pending'}}"
                ><text>{{item.name}}</text><text>{{item.label}}</text></view
              >
              <view
                wx:if="{{settlement.kind==='win' || settlement.drawInfo.kind==='nagashi'}}"
                id="result-yaku-summary" class="result-points {{settlement.summaryVisible?'is-visible':'is-pending'}}"
                ><text class="result-value-meta">{{settlement.kind==='win' ? settlement.hanLabel : '满贯'}}{{settlement.fu ? ' · '+settlement.fu+'符' : ''}}</text><text class="result-value-total"
                  >{{settlement.points}}点</text
                ></view
              >
              <view
                wx:if="{{settlement.stage==='draw' && settlement.drawInfo.kind==='exhaustive'}}"
                ><view
                  wx:for="{{settlement.drawPlayers}}"
                  wx:key="seat"
                  class="draw-player"
                  ><view class="line"
                    ><text>{{item.name}}</text
                    ><text>{{item.tenpai?'听牌':'未听牌'}}</text></view
                  ><view class="winning-rack"
                    ><image
                      wx:for="{{item.hand}}"
                      wx:for-item="t"
                      wx:key="index"
                      src="{{t.src}}"
                      class="tile-small" /><view
                      wx:for="{{item.exposed}}"
                      wx:for-item="set"
                      wx:key="index"
                      class="meld"
                      ><view
                        wx:for="{{set}}"
                        wx:key="index"
                        style="{{item.stackStyle}}" class="meld-tile {{item.called?'called':''}} {{item.added?'added':''}} {{item.back?'back':''}} {{motionTarget===item.nodeId?(flight?'arrival-held':'arrival-pulse'):''}}"
                        ><image
                          wx:if="{{!item.back}}"
                          src="{{item.src}}"
                          class="tile-small" /></view></view></view
                  ><view wx:if="{{item.waits.length}}" class="winning-rack"
                    ><text class="draw-wait-label">听牌</text
                    ><image
                      wx:for="{{item.waits}}"
                      wx:for-item="t"
                      wx:key="index"
                      src="{{t.src}}"
                      class="tile-small" /></view></view
              ></view>
            </block>
            <view
              wx:if="{{settlement.stage==='scores' || settlement.stage==='legacy'}}"
              class="result-balances"
              ><view class="balance balance-heading"
                ><text>玩家</text><text>结算前</text><text>本局收支</text
                ><text>结算后</text></view
              ><view
                wx:for="{{settlement.changes}}"
                wx:key="seat"
                class="balance"
                ><text>{{item.name}}</text
                ><text class="balance-before">{{item.before}}</text
                ><text class="{{item.value>=0?'positive':'negative'}}"
                  >{{item.value>0?'+':''}}{{item.value}}</text
                ><text class="balance-after">{{item.after}}</text></view
              ></view
            >
          </block>
          </scroll-view>
            <view class="result-footer" wx:if="{{!game.ranking}}"
              ><button
                wx:if="{{settlementAck}}"
                class="primary"
                bindtap="continueSettlement"
                disabled="{{busy || !settlement.ready}}"
              >
                {{settlement.ready ? '继续 · '+settlement.countdown :
                '正在展示'}}</button
              ><text wx:else>等待其他玩家</text></view
            >
          <view class="result-footer ranking-footer" wx:else>
            <button wx:if="{{host && ranking.ready}}" bindtap="rematch" disabled="{{busy}}">再来一场</button>
            <button wx:if="{{ranking.ready}}" bindtap="leave" disabled="{{busy}}">返回大厅</button>
          </view>
        </view>
      </view></block
    ></block
  >
</view>
<view wx:if="{{flight}}" class="tile-flight" style="{{flight.style}}" animation="{{flightAnimation}}"><image src="{{flight.src}}" /></view>
