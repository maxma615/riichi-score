.online{padding-bottom:28rpx}.row button{margin:0}.join{display:flex;gap:12rpx;align-items:center}.join input{flex:1;min-width:0}.join button{flex:0 0 120rpx}.table{position:relative;margin:16rpx 0;background:radial-gradient(ellipse at center,#405a54,#1b3832);border:8rpx solid #ad9b6d;border-radius:20rpx;color:#f6eedc;padding:14rpx;box-shadow:0 10rpx 0 #14221e}.table-status{font-size:22rpx;display:flex;flex-direction:column;gap:8rpx}.player{padding:12rpx 0;border-top:1rpx solid #64766c}.player-name{font-size:23rpx;display:flex;gap:8rpx;flex-wrap:wrap}.player-name text:first-child{margin-left:auto}.call{color:#f6d277;font-weight:bold}.backs{display:flex;gap:3rpx;margin-top:8rpx}.back{width:22rpx;height:32rpx;background:linear-gradient(#efc677,#c69943);border:2rpx solid #f4ddab;border-radius:3rpx;box-shadow:0 4rpx 0 #9f7528}.river,.melds{display:flex;flex-wrap:wrap;gap:4rpx;margin-top:8rpx}.meld{display:flex;margin-right:8rpx;border-bottom:4rpx solid #c5b996;border-radius:3rpx}.tile-small{width:29rpx;height:39rpx;background:#f2efdf;border-radius:4rpx;vertical-align:middle;box-shadow:0 4rpx 0 #b8b49d}.hand{display:flex;gap:2rpx;margin:28rpx 0 10rpx;justify-content:center}.tile{width:46rpx;height:65rpx;background:#f4f0df;border-radius:6rpx;box-shadow:0 8rpx 0 #bab49b;transition:transform .15s}.tile image{width:100%;height:100%}.tile.selected{transform:translateY(-16rpx);box-shadow:0 8rpx 0 #a99d6b,0 0 0 3rpx #ac4c34}.actions{display:flex;flex-wrap:wrap;gap:8rpx;margin:18rpx 0}.actions button{margin:0;padding:0 18rpx;min-height:84rpx;display:flex;align-items:center;gap:6rpx}
