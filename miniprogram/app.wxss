page{background:#171b1b;color:#292d2b;font-family:system-ui,"PingFang SC",sans-serif;font-size:28rpx} .page{padding:28rpx}.title{font-family:serif;font-size:48rpx;color:#eee6d8;margin:14rpx 0 32rpx;letter-spacing:6rpx}.card{background:#ede6d7;border:1rpx solid #c0b297;border-radius:6rpx;padding:30rpx;margin-bottom:24rpx}.heading{font-family:serif;font-size:36rpx;margin-bottom:24rpx}.row{display:flex;gap:16rpx;flex-wrap:wrap;align-items:center}.chip{display:inline-flex;align-items:center;justify-content:center;min-width:92rpx;min-height:88rpx;padding:0 18rpx;background:#faf6ed;border:1rpx solid #bcb5a5;border-radius:4rpx;margin:6rpx;box-sizing:border-box}.selected,.primary{background:#993e31!important;color:#fff5e6!important}.label{color:#65685f;margin:20rpx 0 10rpx}.score{font-size:68rpx;font-family:serif;font-variant-numeric:tabular-nums}.result{background:#293632;color:#f5eddb;padding:24rpx;margin:16rpx 0 24rpx;border-radius:4rpx}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #bcb5a560;gap:16rpx}.small{font-size:24rpx;color:#65685f;line-height:1.7}.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#c8beaa}.seat{width:calc(50% - 12rpx);box-sizing:border-box;background:#fffaf055;border:1rpx solid #bcb5a5;padding:20rpx}.dealer{border-color:#993e31}.negative{color:#993e31}.positive{color:#386450}.empty{padding:36rpx 0;color:#65685f}button{font-size:28rpx;border-radius:4rpx;margin:16rpx 0;background:#faf6ed;min-height:88rpx}input,picker{background:#faf6ed;border:1rpx solid #bcb5a5;border-radius:4rpx;min-height:88rpx;padding:16rpx;box-sizing:border-box}button::after{border:0}.qr{width:430rpx;height:430rpx;display:block;margin:24rpx auto}.toolbar{display:flex;gap:20rpx}.toolbar button{flex:1}
.counter{display:flex;align-items:center;justify-content:center;gap:40rpx;padding:24rpx 0}.counter button{width:100rpx;font-size:44rpx;line-height:88rpx;padding:0}.counter text{font-size:38rpx;min-width:160rpx;text-align:center}.round-status{display:flex;align-items:center;gap:40rpx;background:#293632;color:#f5eddb;padding:36rpx;margin:24rpx 0;border-left:8rpx solid #ac6951}.honba-number{font-size:80rpx;font-weight:650;line-height:1}.honba-number text{font-size:28rpx;font-weight:400}.repeat-label{font-size:34rpx;margin-bottom:16rpx}.dealer-label{font-size:24rpx;opacity:.8}.record-status{background:#293632;color:#f5eddb;padding:24rpx;margin-bottom:32rpx}.record-status>text{font-size:44rpx;font-weight:600}.record-status>view{font-size:24rpx;margin-top:12rpx}.payment-head,.payment-row{display:flex;gap:8rpx;padding:20rpx 0;border-bottom:1rpx solid #bcb5a5;font-size:23rpx;text-align:right;font-variant-numeric:tabular-nums}.payment-head>text,.payment-row>text{flex:1;min-width:0}.payment-head>text:first-child,.payment-row>text:first-child{flex:1.2;text-align:left;word-break:break-all}.payment-head{color:#756b5b}.payment-total{font-weight:650}.payment-transfer{font-size:23rpx;color:#756b5b;margin:20rpx 0;line-height:1.5}.next-round{background:#e3dbcb;border-left:6rpx solid #993e31;padding:26rpx;margin-top:30rpx;font-size:26rpx;line-height:1.7}
.record-counter{justify-content:flex-start;padding:0;margin:12rpx 0 28rpx}.record-counter button{margin:0}.fu-choices{display:flex;flex-wrap:wrap;gap:14rpx;margin:16rpx 0 30rpx}.fu-choices button{width:calc((100% - 42rpx)/4);min-height:88rpx;line-height:88rpx;margin:0;padding:0;font-size:26rpx}.fu-choices button[disabled]{opacity:.35}
